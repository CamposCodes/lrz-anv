# URL pública do site (sobrescreve site.url do nuxt.config). Ex.: https://seu-dominio.com.br
NUXT_PUBLIC_SITE_URL=

# WhatsApp em formato internacional, somente dígitos (sem +). Ex.: 5532999999999
NUXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics (gated por consentimento LGPD; só carrega após opt-in)
# Google Analytics 4 (formato G-XXXXXXXXXX)
NUXT_PUBLIC_GTAG_ID=
# Microsoft Clarity (https://clarity.microsoft.com)
NUXT_PUBLIC_CLARITY_ID=
# "false" desliga analytics totalmente (ex.: dev/preview)
NUXT_PUBLIC_ANALYTICS_ENABLED=true
